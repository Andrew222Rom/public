Player
private void Update()
{
    float h = Input.GetAxisRaw("Horizontal");
    float v = Input.GetAxisRaw("Vertical");

    Vector3 move = transform.right * h;
    move += transform.forward * v;

    transform.position += move.normalized * speed * Time.deltaTime;
}




Camera
void Start()
{
    Cursor.lockState = CursorLockMode.Locked;
}

void Update()
{
    float mx = Input.GetAxis("Mouse X") * sens * Time.deltaTime;
    float my = Input.GetAxis("Mouse Y") * sens * Time.deltaTime;

    x -= my;
    x = Mathf.Clamp(x, -60, 60);

    transform.localRotation = Quaternion.Euler(x, 0, 0);
    transform.parent.Rotate(0, mx, 0);
} 

Game
public int coins;
public int totalCoins;

public float timeLeft = 60;

public TMP_Text coinsText;
public TMP_Text timerText;
public TMP_Text resultText;

bool gameEnded;

private void Awake()
{
    Instance = this;
    totalCoins = FindObjectsByType<Coin>(FindObjectsSortMode.None).Length;
}

private void Update()
{
    if (gameEnded) return;

    timeLeft -= Time.deltaTime;

    coinsText.text = $"{coins}/{totalCoins}";
    timerText.text = $"Время: {Mathf.Ceil(timeLeft)}";

    if (coins >= totalCoins) Win();
    if (timeLeft <= 0) Lose();
}

private void Win()
{
    gameEnded = true;
    resultText.text = "ПОБЕДА";
}

private void Lose()
{
    gameEnded = true;
    resultText.text = "ПОРАЖЕНИЕ";
} 
